# Jira Cloud Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT_KEY=DEMO
JIRA_ISSUE_TYPE=Bug
JIRA_PR_TRIGGER_STATUS=Done
JIRA_PR_RAISED_STATUS=PR Raised
JIRA_PR_POLL_INTERVAL_MS=15000
JIRA_PR_POLLER_STATE_FILE=runtime/jira-pr-poller-state.json

# LangFlow Configuration
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_API_KEY=your_langflow_api_key_here
LANGFLOW_WEBHOOK_URL=http://localhost:7860/api/v1/webhook/incident_to_jira

# PM2 & Local Prototype Integration
# The PM2-Log-Viewer is the only active log reader. Keep the legacy collector off.
DIRECT_LOG_COLLECTOR_ENABLED=false
PM2_ERROR_LOG=runtime/pm2/button-demo-error.log
SERVICE_NAME=button-demo
ENVIRONMENT=local
STATE_FILE=runtime/collector-state.json

# GitHub PR flow (demo repository only)
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=anuraag-bagepalli
GITHUB_REPOSITORY=incident-demo-app
GITHUB_BASE_BRANCH=main
