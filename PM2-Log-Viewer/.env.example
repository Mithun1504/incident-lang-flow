# PM2-Log-Viewer Configuration
# Path to the target PM2 error log (resolved relative to this application directory)
PM2_LOG_SOURCE=../LangFlow/runtime/pm2/button-demo-error.log

# Port for the PM2-Log-Viewer server & dashboard
PORT=3001

# LangFlow Incident to Jira Webhook URL
LANGFLOW_WEBHOOK_URL=http://localhost:7860/api/v1/webhook/incident_to_jira

# LangFlow API Key (for x-api-key authentication header)
LANGFLOW_API_KEY=sk-your-langflow-api-key

# Persistent state file for byte offset tracking
LOG_STATE_FILE=runtime/log-viewer-state.json

# Local retry outbox for failed deliveries
OUTBOX_FILE=runtime/outbox.json

# Set to true to forward new incidents to LangFlow webhook, or false for dry-run mode
FORWARD_ENABLED=true
